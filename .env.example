# Copy to .env (development) or set in your platform's secret manager (production).
# Placeholders only - never commit real credentials.

NODE_ENV=development
DATABASE_URL=postgres://paytrace:CHANGE_ME@localhost:5432/paytrace
DATABASE_POOL_MAX=10
# Public origin the browser uses; requests from any other Origin are rejected (CSRF protection).
APP_URL=http://localhost:3000
SESSION_TTL_HOURS=12
# true = run the background job worker inside the web process. Use false with a separate `npm run worker`.
EMBEDDED_WORKER=true
LOG_LEVEL=info
# Optional: enables password-reset and invite emails, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=PayTrace <no-reply@example.com>
# Reverse proxies in front of the app (1 for a typical load balancer, 0 when exposed directly).
TRUSTED_PROXY_HOPS=1

# docker compose only
POSTGRES_PASSWORD=CHANGE_ME
WEB_PORT=3000
